{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://127.0.0.1:8000/rootschema.json",
  "finite_group": {
    "id": "finite_group.json",
    "title": "Finite Group Object",
    "description": "JSON schema for a finite group object",
    "type": "object",
    "required": [ "group_order", "group_GAP_ID", "group_gens_tup", "group_char_degrees", "group_MBS_STPP_param_type", "group_MBS_STPP_size" ],
    "properties": {
      "desc": { "type": "string" },
      "order": { "type": "number" },
      "GAP_ID": { "type": "array",
                        "items": { "type": "number" },
                        "minItems": 2,
                        "maxItems": 2,
                        "uniqueItems": false
                      },
      "GAP_desc": { "type": "string" },
      "GAP_pickled_ID": { "type": "string" },
      "is_abelian": { "type": "boolean" },
      "is_cyclic": { "type": "boolean" },
      "is_simple": { "type": "boolean" },
      "is_nilpotent": { "type": "boolean" },
      "nilpotency_class": { "type": "number" },
      "is_solvable": { "type": "boolean" },
      "derived_length": { "type": "number" },
      "is_pgroup": { "type": "boolean" },
      "generators": { "type": "string" },
      "char_degrees": { "type": "string" },
      "D3": { "type": "number" },
      "MBS_STPP_param_type": { "type": "array",
                               "items": { "type": "number" },
                               "minItems": 3,
                               "maxItems": 3,
                               "uniqueItems": false
                             },
      "Beta0": { "type": "number" }
    }
  },
  "STPP_triple": {
    "id": "STPP_triple.json",
    "title": "Subgroup TPP Triple Object",
    "description": "JSON schema for a subgroup TPP triple object",
    "type": "object",
    "required": [ "parent_group", "member1", "member2", "member3" ],
    "properties": {
      "parent_group": { "$ref": "#/finite_group" },
      "member1": { "$ref": "#/finite_group" },
      "member2": { "$ref": "#/finite_group" },
      "member3": { "$ref": "#/finite_group" },
      "parameter_type": { "type": "string" },
      "size": { "type": "number" }
    }
  }
}
