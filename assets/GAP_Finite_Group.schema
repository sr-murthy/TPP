{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://127.0.0.1:8000/rootschema.json",
  "finite_group": {
    "id": "finite_group.json",
    "title": "Finite Group Object",
    "description": "JSON schema for a finite group object in the GAP system",
    "type": "object",
    "required": [ "group_GAP_Desc", "group_GAP_ID", "group_GAP_OMPickledString", "group_gens_tup", ],
    "properties": {
      "group_description": { "type": "string" },
      "group_order": { "type": "number" },
      "group_GAP_ID": { "type": "string" },
      "group_GAP_Desc": { "type": "string" },
      "group_GAP_OMPickledString": { "type": "string" },
      "group_isabelian": { "type": "boolean" },
      "group_iscyclic": { "type": "boolean" },
      "group_gens_tup": { "type": "string" },
      "group_families": { "type": "string" }
    }
  },
  "subgroup_TPP_triple": {
    "id": "subgroup_TPP_triple.json",
    "title": "Subgroup TPP Triple Object",
    "description": "JSON schema for a subgroup TPP triple object",
    "type": "object",
    "properties": {
      "member1": {
        "group
      },
      "member2": {},
      "member3": {},
    }
  }
}
