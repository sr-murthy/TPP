{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://127.0.0.1:8000/rootschema.json",
  "finite_group": {
    "id": "finite_group.json",
    "title": "Finite Group Object",
    "description": "JSON schema for a finite group object",
    "type": "object",
    "required": [ "group_order", "group_GAP_ID", "group_gens_tup", "group_char_degrees" ],
    "properties": {
      "group_description": { "type": "string" },
      "group_order": { "type": "number" },
      "group_GAP_ID": { "type": "string" },
      "group_GAP_Desc": { "type": "string" },
      "group_GAP_OMPickledString": { "type": "string" },
      "group_isabelian": { "type": "boolean" },
      "group_iscyclic": { "type": "boolean" },
      "group_gens_tup": { "type": "string" },
      "group_families": { "type": "string" },
      "group_char_degrees": { "type": "string" },
      "group_D3": { "type": "number" }
    }
  },
  "subgroup_TPP_triple": {
    "id": "subgroup_TPP_triple.json",
    "title": "Subgroup TPP Triple Object",
    "description": "JSON schema for a subgroup TPP triple object",
    "type": "object",
    "required": [ "parent_group", "member1", "member2", "member3" ],
    "properties": {
      "parent_group": { "$ref": "#/finite_group" },
      "member1": { "$ref": "#/finite_group" },
      "member2": { "$ref": "#/finite_group" },
      "member3": { "$ref": "#/finite_group" },
      "parameter_type": { "type": "string" },
      "size": { "type": "number" }
    }
  }
}
